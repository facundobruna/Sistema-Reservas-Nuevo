# Todo lo que no debe entrar al contexto de build: acelera el envío al daemon
# y evita invalidar el cache por archivos que no afectan la compilación.

# dependencias y artefactos: se reinstalan y recompilan adentro de la imagen
node_modules
.next
out
build
dist
*.tsbuildinfo

# herramientas locales
.claude
.vscode
.idea

# secretos: NUNCA entran a una imagen
.env
.env.*
!.env.example

# Los tests y su config SÍ entran al contexto de build: la etapa `test` del Dockerfile los corre
# adentro del contenedor. La imagen final (`runner`) no se los lleva: copia solo lo compilado.
# Lo que sí queda afuera es el reporte de cobertura que genera una corrida local.
coverage



# basura del sistema operativo
.DS_Store
*.log
