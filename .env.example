# Plantilla de variables de entorno. Copiala a `.env` antes de levantar nada:
#
#     cp .env.example .env
#
# El `.env` NUNCA se commitea (está en .gitignore). Este archivo sí: documenta
# qué variables existen, sin exponer ningún valor real.

# --- Base de datos -----------------------------------------------------------
# Credenciales con las que compose crea el contenedor de Postgres.
DB_USER=reservas
DB_PASSWORD=reservas
DB_NAME=reservas
# Puerto en la máquina host para poder inspeccionar la base con un cliente.
# Si tenés un Postgres local ocupando el 5432, cambialo (por ejemplo, 5433).
DB_PORT=5432

# Conexión a la base. OJO con el host, que es la confusión clásica:
#   - Con `pnpm dev` (la app corre en tu máquina)  → localhost
#   - Con docker compose (la app corre adentro)    → db
# En compose esta variable la pisa el propio docker-compose.yml con el host `db`,
# así que el valor de acá es el que sirve para correr la app FUERA de Docker.
DATABASE_URL=postgresql://reservas:reservas@localhost:5432/reservas

# --- Aplicación --------------------------------------------------------------
# Puerto en el host donde queda publicada la app.
APP_PORT=3000
# URL pública base: se usa para armar links de reserva y magic links.
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Autenticación -----------------------------------------------------------
# Firma las sesiones de staff y los tokens de comensal.
# Generar uno propio con:  openssl rand -base64 32
AUTH_SECRET=changeme-generar-un-secreto-aleatorio

# --- Email -------------------------------------------------------------------
# "console" imprime los emails por consola: es el modo por defecto y no
# requiere ninguna credencial externa. "resend" usa la API de Resend y exige
# RESEND_API_KEY y EMAIL_FROM.
EMAIL_PROVIDER=console
EMAIL_FROM="Reservas <reservas@example.com>"
RESEND_API_KEY=

# --- Facturación (opcional, apagado por defecto) ------------------------------
# El módulo de suscripciones con Mercado Pago queda inactivo mientras estas
# variables estén vacías: el cliente de MP se construye recién cuando se usa esa
# funcionalidad, así que la app arranca y funciona sin ellas. Se dejan
# documentadas porque el código las lee.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
SUBSCRIPTION_PRICE_ARS=15000
