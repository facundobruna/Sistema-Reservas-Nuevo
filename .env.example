# --- Base de datos (Postgres, ver docker-compose.yml) ---
DB_USER=reservas
DB_PASSWORD=reservas
DB_NAME=reservas
DB_PORT=5432
DATABASE_URL=postgresql://reservas:reservas@localhost:5432/reservas

# --- App ---
# URL pública base de la app (usada para armar links de reserva, magic links, etc.)
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Auth ---
# Secreto para firmar sesiones de staff y tokens de comensal. Generar con: openssl rand -base64 32
AUTH_SECRET=changeme-generate-a-random-secret

# --- Email (EmailSender) ---
# "console" imprime los emails por consola (default en local). "resend" usa la API de Resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Reservas <reservas@example.com>"

# --- Jobs (pg-boss corre sobre el mismo Postgres, no requiere variables extra) ---
